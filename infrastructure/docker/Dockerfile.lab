# syntax=docker/dockerfile:1.7
# Hybrid Cloud Works Migration Explorer — lab API + the pane app the website frames. No Azure clients, no credentials.
# Build context is this repository's root. The two upstream packages are the tarballs attached to the upstream GitHub
# Release of the pinned v* tag: package.json names them by URL, package-lock.json carries their integrity hash, and
# `npm ci` fetches and verifies them like registry packages (ADR-0030; no sibling checkout).
# docker build -f infrastructure/docker/Dockerfile.lab .
#
# Base image pinned by digest (the multi-arch index of node:26-trixie-slim, resolved from Docker Hub on 2026-11-13:
# Node 26.13.1, Node's 2026-11-11 security release; the 26.13.1-trixie-slim tag resolves to the same digest). Moved
# from node:26-bookworm-slim (Debian 12, apt 2.6.1) for CVE-2026-109518 (website issue
# saulpatinojr/HCW-HybridCloudWorks#1562): Debian 13 is the current stable release, and the other add-on images already
# build on it. `docker buildx imagetools inspect node:26-trixie-slim` prints this
# digest; a later tag move is adopted deliberately by changing both parts of the line together (Dependabot's docker
# ecosystem proposes it). tests/contract/lab-image.test.mjs pins the shape of this file.
ARG NODE_IMAGE=node:26-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc
FROM ${NODE_IMAGE} AS build
WORKDIR /srv/addon
COPY package.json package-lock.json tsconfig.base.json tsconfig.build.json ./
COPY apps ./apps
# The API (tsc) and the pane (vite) both build before devDependencies are pruned; the pane's dist/ is what the API serves.
RUN npm ci --no-audit --no-fund && npm run build && npm prune --omit=dev

FROM ${NODE_IMAGE}
ARG ADDON_VERSION=0.3.0
LABEL org.opencontainers.image.title="img-mo-lab-addon" \
      org.opencontainers.image.description="Hybrid Cloud Works migration assessment AddOn: lab API and pane. No Azure clients, no credentials." \
      org.opencontainers.image.source="https://github.com/saulpatinojr/HCW-MigrateOrchestrator_AddOn" \
      org.opencontainers.image.version="${ADDON_VERSION}" \
      org.opencontainers.image.licenses="MIT"
ENV NODE_ENV=production PORT=8080 AMO_STATIC_DIR=/srv/addon/apps/lab-web/dist
WORKDIR /srv/addon
# Debian's security updates on top of the digest-pinned base (Trivy in publish-images.yml, and the website's Docker Scout
# check, refuse fixable HIGH/CRITICAL findings). A security upload reaches the mirrors days before the official Node image
# is rebuilt with it, so a digest bump alone cannot always clear a finding; this step closes that window.
# `Acquire::Retries=0`: the apt doing this upgrade is still the base's, and CVE-2026-109518 needs a download retry to slip
# an unverified package in, so retries stay off until the upgraded apt is in place (a mirror hiccup fails the build instead).
# `--error-on=any`: the update fails if any index (the security one above all) cannot be fetched, instead of succeeding
# with a warning and leaving the base unupgraded. PUBLISH_CACHE_BUST is a per-run value publish-images.yml passes (its run
# id and attempt); naming it in the command gives this layer a different cache key on every publish run, so a rebuild can
# never reuse an older upgrade result after a newer security upload. Unset on a local build, where the layer caches as usual.
ARG PUBLISH_CACHE_BUST=
RUN printf 'upgrade run: %s\n' "${PUBLISH_CACHE_BUST}" \
    && apt-get -o Acquire::Retries=0 update --error-on=any \
    && apt-get -o Acquire::Retries=0 upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
# The upstream tarballs were installed into node_modules like registry packages; the rule corpus ships inside migration-core.
COPY --from=build /srv/addon/node_modules ./node_modules
COPY --from=build /srv/addon/apps/lab-api/dist ./apps/lab-api/dist
COPY --from=build /srv/addon/apps/lab-api/package.json ./apps/lab-api/package.json
COPY --from=build /srv/addon/apps/lab-web/dist ./apps/lab-web/dist
COPY --from=build /srv/addon/package.json ./
COPY samples/resources-csv ./samples/resources-csv
# The runtime needs node only: drop the bundled npm/npx/corepack (and their CVE surface).
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack && chown -R node:node /srv
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/lab-api/dist/server.js"]
